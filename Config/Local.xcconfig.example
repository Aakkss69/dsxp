// Copy to Config/Local.xcconfig (gitignored) and fill in your team ID.
//
// One-time setup: Xcode > Settings > Accounts > add your Apple ID >
// Manage Certificates > + > Apple Development. Your team ID is the
// "OU" of that certificate (security find-identity -v -p codesigning
// lists the certificate; Keychain Access shows its OU).

CODE_SIGN_IDENTITY = Apple Development
DEVELOPMENT_TEAM = XXXXXXXXXX
